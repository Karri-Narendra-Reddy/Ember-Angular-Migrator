# ── Azure APIM Connection (copy from knowledge.py) ─────────────────────────
APIM_BASE_URL=https://pre4apim.azure-api.net
APIM_KEY=<your-api-key-here>
API_VERSION=2024-02-01

# ── Model Overrides (optional – defaults shown) ──────────────────────────────
MODEL_ORCHESTRATOR=o4-mini
MODEL_ANALYZER=gpt-4.1
MODEL_STRUCTURE=gpt-4.1
MODEL_MIGRATION=gpt-5
MODEL_VALIDATOR=gpt-4.1-mini
MODEL_EMBEDDING=text-embedding-3-large

# ── Migration Paths ──────────────────────────────────────────────────────────
EMBER_PROJECT_PATH=./my-ember-app
ANGULAR_OUTPUT_PATH=./angular_output
STATE_FILE=migration_state.json
VECTOR_STORE_PATH=./vector_store
LOGS_DIR=./logs

# ── File Reading ─────────────────────────────────────────────────────────────
CHUNK_SIZE_LINES=500
CHUNK_OVERLAP=50
MAX_LINES_PER_FILE=20000

# ── Token Budgets (optional) ─────────────────────────────────────────────────
MAX_TOKENS_MIGRATION=32000
MAX_TOKENS_ANALYZER=16000
